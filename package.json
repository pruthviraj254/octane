{
  "name": "octane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "test": "pnpm -r test && pnpm test:contracts",
    "test:contracts": "forge test --root contracts --no-match-path 'test/fork/*'",
    "test:fork": "forge test --root contracts --match-path 'test/fork/*' -vv",
    "typecheck": "pnpm -r typecheck",
    "fixture:quote": "pnpm --filter @octane/sdk fixture:quote",
    "makers": "pnpm --filter @octane/makers all",
    "maker": "pnpm --filter @octane/makers start",
    "web": "pnpm --filter @octane/web dev"
  },
  "devDependencies": {
    "@forshtat/hegota-support": "0.0.1"
  }
}
