octane.rishabhprajapati.me {
	encode gzip

	# The desk route refuses the public unless DESK_PUBLIC=true. This site only matches its own
	# hostname, so a forged Host header can't pass as local.
	handle_path /m/cautious/* {
		reverse_proxy 127.0.0.1:8801
	}
	handle_path /m/aggressive/* {
		reverse_proxy 127.0.0.1:8802
	}
	handle_path /m/balancer/* {
		reverse_proxy 127.0.0.1:8803
	}
	handle_path /m/nova/* {
		reverse_proxy 127.0.0.1:8804
	}
	handle_path /m/eth/* {
		reverse_proxy 127.0.0.1:8808
	}

	# Makers added from the desk get a path by port, so they need no entry here.
	@maker path_regexp maker ^/p/(88[0-9]{2})(/.*)$
	handle @maker {
		rewrite * {re.maker.2}
		reverse_proxy 127.0.0.1:{re.maker.1}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
