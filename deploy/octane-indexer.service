[Unit]
Description=Octane indexer
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/octane/apps/indexer
EnvironmentFile=/home/ubuntu/octane/deploy/hosted.env
Environment=PATH=/opt/node/bin:/usr/bin:/bin
ExecStart=/opt/node/bin/node --import tsx src/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
